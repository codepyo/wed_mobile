{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wed-mobile",
  "compatibility_date": "2026-08-22",
  "main": "./.worker/index.js",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "WEDDING_DB",
      "database_name": "wedding-db-production",
      "database_id": "fe92ba88-91fd-4c8a-9a42-1ee6909ba64c",
      "preview_database_id": "2274b0eb-1a9c-49bf-a219-90ca686a5d97"
    }
  ]
}
