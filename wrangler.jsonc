{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wed-mobile",
  "compatibility_date": "2026-08-22",
  "main": "./.worker/index.js",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
